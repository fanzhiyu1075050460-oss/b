name: Build APK

on:
  push:
    branches:
      - main
  pull_request:
    branches:
      - main

jobs:
  build:
    runs-on: ubuntu-latest
    steps:步骤：步骤：
      - name: Checkout- 名称：检出代码
        uses: actions/checkout@v4使用：actions/checkout@v4
      - name: Setup Flutter- 名称：设置 Flutter
        uses: subosito/flutter-action@v2使用：subosito/flutter-action@v2用途: subosito/flutter-action@v2使用：subosito/flutter-action@v2
        with:包含：
          channel: stable通道：稳定渠道: stable通道：稳定
      - name: Install dependencies- 名称：安装依赖项
        run: flutter pub get运行：flutter pub get
      - name: Build APK- 名称：构建APK
        run: flutter build apk --release运行：flutter build apk --release
      - name: Upload APK- 名称：上传APK
        uses: actions/upload-artifact@v4使用：actions/upload-artifact@v4
        with:包含：
          name: app-release.apk名称：app-release.apk名称: app-release.apk名称：app-release.apk
          path: build/app/outputs/flutter-apk/app-release.apk路径：build/app/outputs/flutter-apk/app-release.apk路径：build/app/outputs/flutter-apk/app-release.apk路径：build/app/outputs/flutter-apk/app-release.apk
